{
  "info": {
    "name": "Ticket Service — Гелиос",
    "description": "Сначала выполните создание билета. ticketId сохранится автоматически. Затем запускайте нужные запросы по отдельности. Статус в названии указан для текущей версии сервиса. Удаление по типу затрагивает любой VIP-билет из общей коллекции.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://se.ifmo.ru/~s412939/ticket-service",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "201 — создать билет и сохранить ticketId для следующих запросов",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Билет для проверки API\",\n  \"coordinates\": {\"x\": 12.5, \"y\": 100},\n  \"price\": 2500,\n  \"comment\": \"Первый ряд\",\n  \"type\": \"USUAL\",\n  \"venue\": {\n    \"name\": \"Главный стадион\",\n    \"capacity\": 50000,\n    \"type\": \"STADIUM\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"ticketId\", pm.response.json().id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "200 — получить созданный билет",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tickets/{{ticketId}}"
      },
      "response": []
    },
